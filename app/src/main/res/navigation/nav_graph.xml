<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.baghdad.edulife.features.onboarding.ui.OnboardingFragment"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.baghdad.edulife.features.auth.ui.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_teacherDashboardFragment"
            app:destination="@id/teacherDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_groupAdminDashboardFragment"
            app:destination="@id/groupAdminDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.baghdad.edulife.features.auth.ui.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Authenticated area used by the bottom navigation destinations. -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.baghdad.edulife.features.courses.ui.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_careerAdvisorFragment"
            app:destination="@id/careerAdvisorFragment" />
        <action
            android:id="@+id/action_homeFragment_to_plannerFragment"
            app:destination="@id/plannerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_gamificationFragment"
            app:destination="@id/gamificationFragment" />
    </fragment>

    <fragment
        android:id="@+id/coursesFragment"
        android:name="com.baghdad.edulife.features.courses.ui.CoursesFragment"
        android:label="Courses">
        <action
            android:id="@+id/action_coursesFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/careerAdvisorFragment"
        android:name="com.baghdad.edulife.features.advisor.ui.AdvisorFragment"
        android:label="AI Advisor">
        <action
            android:id="@+id/action_careerAdvisorFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.baghdad.edulife.features.profile.ui.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profileFragment_to_certificatesFragment"
            app:destination="@id/certificatesFragment" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_teacherRequestFragment"
            app:destination="@id/teacherRequestFragment" />
        <action
            android:id="@+id/action_profileFragment_to_studentAnalyticsFragment"
            app:destination="@id/studentAnalyticsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_gamificationFragment"
            app:destination="@id/gamificationFragment" />
        <action
            android:id="@+id/action_profileFragment_to_leaderboardFragment"
            app:destination="@id/leaderboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.baghdad.edulife.features.profile.ui.EditProfileFragment"
        android:label="Edit Profile" />

    <fragment
        android:id="@+id/teacherRequestFragment"
        android:name="com.baghdad.edulife.features.profile.ui.TeacherRequestFragment"
        android:label="Become a Teacher" />

    <fragment
        android:id="@+id/certificatesFragment"
        android:name="com.baghdad.edulife.features.certificates.ui.CertificatesFragment"
        android:label="Certificates">
        <action
            android:id="@+id/action_certificatesFragment_to_certificateDetailFragment"
            app:destination="@id/certificateDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/certificateDetailFragment"
        android:name="com.baghdad.edulife.features.certificates.ui.CertificateDetailFragment"
        android:label="Certificate">
        <argument
            android:name="certId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/courseDetailFragment"
        android:name="com.baghdad.edulife.features.courses.ui.CourseDetailFragment"
        android:label="Course Detail">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseTitle"
            app:argType="string"
            android:defaultValue="Course" />
        <argument
            android:name="courseLevel"
            app:argType="string"
            android:defaultValue="BEGINNER" />
        <argument
            android:name="courseLanguage"
            app:argType="string"
            android:defaultValue="en" />
        <argument
            android:name="courseDesc"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="isEnrolled"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_courseDetailFragment_to_enrollCourseFragment"
            app:destination="@id/enrollCourseFragment" />
        <action
            android:id="@+id/action_courseDetailFragment_to_lessonPlayerFragment"
            app:destination="@id/lessonPlayerFragment" />
        <action
            android:id="@+id/action_courseDetailFragment_to_examFragment"
            app:destination="@id/examFragment" />
    </fragment>

    <fragment
        android:id="@+id/enrollCourseFragment"
        android:name="com.baghdad.edulife.features.courses.ui.EnrollCourseFragment"
        android:label="Enroll">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseLevel"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseLanguage"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseDesc"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="sectionCount"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="lessonCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/examFragment"
        android:name="com.baghdad.edulife.features.courses.ui.ExamFragment"
        android:label="Exam">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_examFragment_to_examResultFragment"
            app:destination="@id/examResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/examResultFragment"
        android:name="com.baghdad.edulife.features.courses.ui.ExamResultFragment"
        android:label="Exam Result">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="examId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="score"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="passScore"
            app:argType="integer"
            android:defaultValue="80" />
        <argument
            android:name="passed"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="certificateNumber"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="attemptsUsed"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="cooldownEndsAt"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- ── Admin area ────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.baghdad.edulife.features.admin.ui.AdminDashboardFragment"
        android:label="Admin Dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_teacherRequestsFragment"
            app:destination="@id/teacherRequestsFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_platformAnalyticsFragment"
            app:destination="@id/platformAnalyticsFragment" />
    </fragment>

    <fragment
        android:id="@+id/teacherRequestsFragment"
        android:name="com.baghdad.edulife.features.admin.ui.TeacherRequestsFragment"
        android:label="Teacher Requests" />

    <!-- ── Teacher CMS area ────────────────────────────────────────── -->

    <fragment
        android:id="@+id/teacherDashboardFragment"
        android:name="com.baghdad.edulife.features.teacher.ui.TeacherDashboardFragment"
        android:label="My Courses">
        <action
            android:id="@+id/action_teacherDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_teacherDashboardFragment_to_cmsCourseDetailFragment"
            app:destination="@id/cmsCourseDetailFragment" />
        <action
            android:id="@+id/action_teacherDashboardFragment_to_teacherAnalyticsFragment"
            app:destination="@id/teacherAnalyticsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cmsCourseDetailFragment"
        android:name="com.baghdad.edulife.features.teacher.ui.CmsCourseDetailFragment"
        android:label="Course Detail">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseTitle"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_cmsCourseDetailFragment_to_cmsExamBuilderFragment"
            app:destination="@id/cmsExamBuilderFragment" />
    </fragment>

    <fragment
        android:id="@+id/cmsExamBuilderFragment"
        android:name="com.baghdad.edulife.features.exams.ui.CmsExamBuilderFragment"
        android:label="Final Exam Builder">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="courseTitle"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- ── Group admin area ─────────────────────────────────────────── -->

    <fragment
        android:id="@+id/groupAdminDashboardFragment"
        android:name="com.baghdad.edulife.features.groupadmin.ui.GroupAdminDashboardFragment"
        android:label="My Cohorts">
        <action
            android:id="@+id/action_groupAdminDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_groupAdminDashboardFragment_to_groupDetailFragment"
            app:destination="@id/groupDetailFragment" />
        <action
            android:id="@+id/action_groupAdminDashboardFragment_to_courseApprovalsFragment"
            app:destination="@id/courseApprovalsFragment" />
    </fragment>

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.baghdad.edulife.features.groupadmin.ui.GroupDetailFragment"
        android:label="Group">
        <argument
            android:name="groupId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="groupName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/courseApprovalsFragment"
        android:name="com.baghdad.edulife.features.groupadmin.ui.CourseApprovalsFragment"
        android:label="Course Approvals" />

    <fragment
        android:id="@+id/lessonPlayerFragment"
        android:name="com.baghdad.edulife.features.courses.ui.LessonPlayerFragment"
        android:label="Lesson">
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lessonId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lessonTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lessonSummary"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lessonType"
            app:argType="string"
            android:defaultValue="VIDEO" />
        <argument
            android:name="durationMinutes"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="isPreview"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="sectionTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="orderInSection"
            app:argType="integer"
            android:defaultValue="1" />
    </fragment>

    <fragment
        android:id="@+id/plannerFragment"
        android:name="com.baghdad.edulife.features.courses.ui.PlannerFragment"
        android:label="Planner">
        <action
            android:id="@+id/action_plannerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/gamificationFragment"
        android:name="com.baghdad.edulife.features.gamification.ui.GamificationFragment"
        android:label="Achievements">
        <action
            android:id="@+id/action_gamificationFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
        <action
            android:id="@+id/action_gamificationFragment_to_leaderboardFragment"
            app:destination="@id/leaderboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.baghdad.edulife.features.gamification.ui.LeaderboardFragment"
        android:label="Leaderboard" />

    <!-- ── Analytics dashboards (Phase B) ───────────────────────────── -->

    <fragment
        android:id="@+id/studentAnalyticsFragment"
        android:name="com.baghdad.edulife.features.analytics.ui.StudentAnalyticsFragment"
        android:label="My Learning Stats" />

    <fragment
        android:id="@+id/teacherAnalyticsFragment"
        android:name="com.baghdad.edulife.features.analytics.ui.TeacherAnalyticsFragment"
        android:label="Course Performance" />

    <fragment
        android:id="@+id/platformAnalyticsFragment"
        android:name="com.baghdad.edulife.features.analytics.ui.PlatformAnalyticsFragment"
        android:label="Platform Analytics" />

</navigation>
