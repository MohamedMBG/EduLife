<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.baghdad.edulife.features.onboarding.ui.OnboardingFragment"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.baghdad.edulife.features.auth.ui.LoginFragment"
        android:label="Login">
        <!--
            popUpTo nav_graph + inclusive=true removes the entire back stack including onboarding/login.
            The user must not be able to press back from home to return to the login or onboarding screens.
        -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <!-- Allows a user on the login screen to navigate to registration. -->
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.baghdad.edulife.features.auth.ui.RegisterFragment"
        android:label="Register">
        <!-- Allows the register screen to navigate back to login (e.g. "Already have an account?" link). -->
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.baghdad.edulife.features.courses.ui.HomeFragment"
        android:label="Home">
        <!--
            Auth guard and logout both use this action.
            popUpTo nav_graph + inclusive=true ensures the authenticated home screen is fully
            removed from the back stack before the user lands on login.
        -->
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
