<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_teacher_course_card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <!-- Question header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/questionNumberLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/teacher_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Question 1" />

        <TextView
            android:id="@+id/removeQuestionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cms_exam_remove"
            android:textColor="@color/brand_error"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Question text input -->
    <EditText
        android:id="@+id/questionTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/cms_exam_question_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:textSize="14sp"
        android:textColor="@color/teacher_text_primary"
        android:textColorHint="@color/teacher_text_secondary"
        android:backgroundTint="@color/teacher_border" />

    <!-- Choices label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cms_exam_choices_label"
        android:textColor="@color/teacher_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Choices container (dynamically populated) -->
    <LinearLayout
        android:id="@+id/choicesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- Add choice button -->
    <TextView
        android:id="@+id/addChoiceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cms_exam_add_choice"
        android:textColor="@color/teacher_accent"
        android:textSize="13sp"
        android:paddingVertical="4dp" />

</LinearLayout>
