<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/admin_header_bg"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_eyebrow"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/analytics_platform_eyebrow"
                android:textColor="@color/admin_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/analytics_platform_title"
                android:textColor="@color/admin_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/analytics_platform_subtitle"
                android:textColor="@color/admin_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Loading / error -->
        <LinearLayout
            android:id="@+id/platformStateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_catalog_card"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/platformLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:indicatorColor="@color/admin_accent"
                app:trackColor="@color/admin_border"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/platformStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                tools:text="@string/analytics_platform_loading" />

            <TextView
                android:id="@+id/platformRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_admin_logout_button"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="@string/analytics_retry"
                android:textColor="@color/admin_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:id="@+id/platformContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Users section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/analytics_platform_section_users"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:weightSum="2">

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileLearners"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <Space android:layout_width="16dp" android:layout_height="1dp" />

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileTeachers"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:weightSum="2">

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileGroupAdmins"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <Space android:layout_width="16dp" android:layout_height="1dp" />

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileAdmins"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <!-- Content & activity section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/analytics_platform_section_content"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:weightSum="2">

                <include layout="@layout/item_analytics_tile" android:id="@+id/tilePublished"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <Space android:layout_width="16dp" android:layout_height="1dp" />

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileDraft"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:weightSum="2">

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileEnrollments"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <Space android:layout_width="16dp" android:layout_height="1dp" />

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileCertificates"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:weightSum="2">

                <include layout="@layout/item_analytics_tile" android:id="@+id/tileAttempts"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

                <Space android:layout_width="16dp" android:layout_height="1dp" />

                <include layout="@layout/item_analytics_tile" android:id="@+id/tilePassed"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <!-- Phase C cohort analytics. Loads independently; rows inflated at runtime. -->
            <TextView
                android:id="@+id/platformCohortStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:textColor="@color/admin_text_secondary"
                android:textSize="14sp"
                tools:text="@string/analytics_trend_loading" />

            <!-- Completion funnel -->
            <TextView
                android:id="@+id/platformFunnelHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/analytics_funnel_section"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/platformFunnelContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp" />

            <!-- Enrollment cohorts by month -->
            <TextView
                android:id="@+id/platformCohortsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/analytics_platform_cohorts_section"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/platformCohortsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp" />

            <!-- Certificate trend by month -->
            <TextView
                android:id="@+id/platformCertTrendHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/analytics_platform_cert_trend_section"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/platformCertTrendContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
