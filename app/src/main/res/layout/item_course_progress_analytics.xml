<?xml version="1.0" encoding="utf-8"?>
<!-- One course progress card on the Study Analytics screen: title + percent, slim bar,
     lessons completed/total, and last activity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/study_card_gap"
    android:background="@drawable/bg_study_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/study_card_padding"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/courseProgressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/brand_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Web Development" />

        <TextView
            android:id="@+id/courseProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/brand_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="82%" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/courseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/bg_planner_progress_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/courseProgressLessons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp"
            tools:text="18 / 22 lessons" />

        <TextView
            android:id="@+id/courseProgressLastActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/brand_text_muted"
            android:textSize="13sp"
            tools:text="Last activity: Today" />
    </LinearLayout>
</LinearLayout>
