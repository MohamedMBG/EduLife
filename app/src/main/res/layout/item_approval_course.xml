<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_teacher_course_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/approvalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/teacher_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Advanced Kotlin Coroutines" />

    <TextView
        android:id="@+id/approvalAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/teacher_text_secondary"
        android:textSize="13sp"
        tools:text="by teacher@example.com" />

    <TextView
        android:id="@+id/approvalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_teacher_add_section_button"
        android:paddingHorizontal="20dp"
        android:paddingVertical="9dp"
        android:text="@string/approvals_approve_button"
        android:textColor="@color/teacher_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
