<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_course_card"
    android:orientation="vertical">

    <!-- Course info row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Green accent bar -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:background="@color/brand_primary" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/enrolledLevelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_level_beginner"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="BEGINNER" />

            <TextView
                android:id="@+id/enrolledCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/brand_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Math Bac SM - Algebra Foundations" />

            <TextView
                android:id="@+id/enrolledCourseDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="2"
                android:textColor="@color/brand_text_body"
                android:textSize="13sp"
                tools:text="A structured algebra refresher for Moroccan Bac Sciences Math students." />

            <TextView
                android:id="@+id/enrolledCourseLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/brand_text_secondary"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_book_open"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_text_secondary"
                tools:text="French" />

            <TextView
                android:id="@+id/enrolledCourseProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_primary"
                tools:text="3 / 8 lessons · 38%" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/continueLearningButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Continue Learning"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_primary" />

        <TextView
            android:id="@+id/unenrollButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="Unenroll"
            android:textColor="@color/brand_error"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
