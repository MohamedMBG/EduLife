<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teacher_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header card -->
            <LinearLayout
                android:id="@+id/teacherHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teacher_surface"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_dashboard_subtitle"
                    android:textColor="@color/teacher_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/teacherWelcomeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/teacher_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Teacher Dashboard" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/teacher_dashboard_title"
                    android:textColor="@color/teacher_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Analytics CTA — opens the owned-course performance screen. -->
            <LinearLayout
                android:id="@+id/teacherAnalyticsCta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_teacher_course_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/teacher_accent"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_teacher_cta_title"
                        android:textColor="@color/teacher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/analytics_teacher_cta_subtitle"
                        android:textColor="@color/teacher_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="›"
                    android:textColor="@color/teacher_text_secondary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Loading / error state card -->
            <LinearLayout
                android:id="@+id/teacherStateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_teacher_course_card"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="28dp"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/teacherLoadingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorColor="@color/teacher_accent"
                    app:trackColor="@color/teacher_border"
                    android:indeterminate="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/teacherStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/teacher_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    tools:text="@string/teacher_loading" />

                <TextView
                    android:id="@+id/teacherRetryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_teacher_add_section_button"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="9dp"
                    android:text="@string/teacher_retry"
                    android:textColor="@color/teacher_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/teacherEmptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="48dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_no_courses_title"
                    android:textColor="@color/teacher_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/teacher_no_courses_body"
                    android:textColor="@color/teacher_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Courses list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/teacherCoursesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_cms_course" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/teacherFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="@string/teacher_create_course_title"
        app:backgroundTint="@color/brand_primary"
        app:tint="@color/white"
        app:srcCompat="@android:drawable/ic_input_add"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
