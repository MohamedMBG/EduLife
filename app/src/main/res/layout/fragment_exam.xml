<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_background">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/examTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="14dp"
        android:background="@color/brand_surface">

        <ImageButton
            android:id="@+id/examBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_enroll_icon_button"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/brand_text_primary"
            android:contentDescription="@string/exam_back_cd" />

        <TextView
            android:id="@+id/examTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/exam_title_default"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary" />

        <TextView
            android:id="@+id/examTopProgressPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_eyebrow"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/examLoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="gone" />

    <!-- Status text (error / empty) -->
    <TextView
        android:id="@+id/examStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textSize="15sp"
        android:textColor="@color/brand_text_secondary"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/examGateContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_max="@dimen/max_form_width"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/bg_catalog_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

            <TextView
                android:id="@+id/examGateEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_eyebrow"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/examGateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/brand_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/examGateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/brand_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/examGateMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/brand_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/examGateButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_enroll_cta_button"
                android:text="@string/exam_gate_button_back"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Content scroll -->
    <ScrollView
        android:id="@+id/examScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                app:layout_constraintWidth_max="@dimen/max_form_width"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <!-- Exam header card -->
            <LinearLayout
                android:id="@+id/examHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_catalog_card"
                android:padding="22dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_auth_eyebrow"
                    android:letterSpacing="0.08"
                    android:text="@string/exam_header_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/examTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/examPassScoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cert_icon"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary" />

                    <TextView
                        android:id="@+id/examQuestionCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_cert_icon"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Questions injected here programmatically -->
            <LinearLayout
                android:id="@+id/examQuestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Submit footer -->
    <LinearLayout
        android:id="@+id/examSubmitFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_surface"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/examProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/brand_primary"
            app:trackColor="@color/brand_primary_surface"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/examProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/brand_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/examSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/exam_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_exam_submit_button"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
