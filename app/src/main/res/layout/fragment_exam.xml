<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/examBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_enroll_icon_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/brand_text_primary" />

        <TextView
            android:id="@+id/examTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/brand_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/examLoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="56dp"
        android:visibility="gone" />

    <!-- Status / error -->
    <TextView
        android:id="@+id/examStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="@color/brand_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Exam content -->
    <ScrollView
        android:id="@+id/examScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Exam meta strip -->
            <LinearLayout
                android:id="@+id/examMetaStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_course_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/examPassScoreText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/examQuestionCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Questions injected programmatically -->
            <LinearLayout
                android:id="@+id/examQuestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Submit footer -->
    <LinearLayout
        android:id="@+id/examSubmitFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/examValidationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textColor="@color/brand_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/examSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_enroll_cta_button"
            android:text="@string/exam_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
