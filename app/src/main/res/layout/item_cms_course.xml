<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_teacher_course_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/cmsCourseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/teacher_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Introduction to Android Development" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cmsCourseDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/teacher_text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="A comprehensive course on building Android apps with Java and XML." />

        <TextView
            android:id="@+id/cmsCourseStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_teacher_status_draft"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="DRAFT" />
    </LinearLayout>

</LinearLayout>
