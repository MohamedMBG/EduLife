<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/badgeCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_badge_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="18dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/badgeIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_badge_first_steps" />

    <TextView
        android:id="@+id/badgeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/brand_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="First Steps" />

    <TextView
        android:id="@+id/badgeDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/brand_text_secondary"
        android:textSize="10sp"
        tools:text="Complete your first lesson" />

    <ImageView
        android:id="@+id/badgeLockIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
