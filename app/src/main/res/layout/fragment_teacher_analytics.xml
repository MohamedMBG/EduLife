<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teacher_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teacher_surface"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analytics_teacher_eyebrow"
            android:textColor="@color/teacher_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/analytics_teacher_title"
            android:textColor="@color/teacher_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/analytics_teacher_subtitle"
            android:textColor="@color/teacher_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Loading / error state card -->
    <LinearLayout
        android:id="@+id/teacherAnalyticsStateCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_teacher_course_card"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/teacherAnalyticsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/teacher_accent"
            app:trackColor="@color/teacher_border"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/teacherAnalyticsStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/teacher_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            tools:text="@string/analytics_teacher_loading" />

        <TextView
            android:id="@+id/teacherAnalyticsRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_teacher_add_section_button"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/analytics_retry"
            android:textColor="@color/teacher_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/teacherAnalyticsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analytics_teacher_empty_title"
            android:textColor="@color/teacher_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/analytics_teacher_empty_body"
            android:textColor="@color/teacher_text_secondary"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Per-course analytics list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/teacherAnalyticsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_teacher_course_analytics" />

</LinearLayout>
