<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/detail_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/detail_padding_horizontal"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_enroll_icon_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/brand_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/cert_detail_title"
            android:textColor="@color/brand_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/certDetailProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="56dp"
        android:visibility="gone" />

    <!-- Error -->
    <TextView
        android:id="@+id/certDetailError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="@color/brand_error"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/certDetailContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:fillViewport="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                app:layout_constraintWidth_max="@dimen/max_form_width"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <!-- ─── Decorated certificate frame ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cert_frame"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <!-- Seal -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_cert_seal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cert_seal_description"
                        android:src="@drawable/ic_cert_seal_star" />
                </FrameLayout>

                <!-- Eyebrow -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.32"
                    android:text="@string/cert_detail_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/cert_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Top ornament -->
                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/cert_ornament_description"
                    android:src="@drawable/ic_cert_ornament" />

                <!-- Award clause -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/cert_detail_award_clause"
                    android:textColor="@color/cert_ink_muted"
                    android:textSize="13sp" />

                <!-- Student name (hero) -->
                <TextView
                    android:id="@+id/certDetailStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="cursive"
                    android:gravity="center"
                    android:textColor="@color/cert_ink"
                    android:textSize="32sp"
                    android:textStyle="bold|italic" />

                <!-- Underline accent -->
                <View
                    android:layout_width="180dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/cert_gold_soft" />

                <!-- For completing -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/cert_detail_for_completing"
                    android:textColor="@color/cert_ink_muted"
                    android:textSize="13sp" />

                <!-- Course title -->
                <TextView
                    android:id="@+id/certDetailCourseTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="@color/cert_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/certDetailCompletionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="@color/cert_ink_muted"
                    android:textSize="13sp" />

                <!-- Bottom ornament -->
                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@string/cert_ornament_description"
                    android:src="@drawable/ic_cert_ornament" />

                <!-- Signature row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingEnd="6dp">

                        <TextView
                            android:id="@+id/certDetailIssuedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/cert_ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/cert_gold_soft" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="@string/cert_detail_date_label"
                            android:textAllCaps="true"
                            android:textColor="@color/cert_ink_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="6dp">

                        <TextView
                            android:id="@+id/certDetailIssuer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="cursive"
                            android:textColor="@color/cert_ink"
                            android:textSize="18sp"
                            android:textStyle="italic" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="0dp"
                            android:background="@color/cert_gold_soft" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="@string/cert_detail_signature_label"
                            android:textAllCaps="true"
                            android:textColor="@color/cert_ink_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Certificate number pill -->
                <TextView
                    android:id="@+id/certDetailNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_cert_number_pill"
                    android:fontFamily="monospace"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/cert_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ─── Verification block (outside frame) ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_settings_item"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/cert_detail_hash_label"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/certDetailHash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action buttons -->
            <Button
                android:id="@+id/certDownloadBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_enroll_cta_button"
                android:text="@string/cert_download_pdf"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/certShareBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand_surface_muted"
                android:text="@string/cert_detail_share"
                android:textAllCaps="false"
                android:textColor="@color/brand_text_primary"
                android:textSize="15sp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
