<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Badge Icon -->
    <ImageView
        android:id="@+id/dialogBadgeIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Badge Name -->
    <TextView
        android:id="@+id/dialogBadgeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/brand_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Rarity Pill -->
    <TextView
        android:id="@+id/dialogBadgeRarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_dialog_pill"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Description -->
    <TextView
        android:id="@+id/dialogBadgeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/brand_text_secondary"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Earned / Locked Status Pill -->
    <TextView
        android:id="@+id/dialogBadgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_badge_dialog_pill"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Close Button -->
    <Button
        android:id="@+id/dialogCloseButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_enroll_cta_button"
        app:backgroundTint="@null"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
