<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_teacher_course_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memberEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/teacher_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="learner@example.com" />

        <TextView
            android:id="@+id/memberRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/teacher_text_secondary"
            android:textSize="12sp"
            tools:text="LEARNER" />
    </LinearLayout>

    <TextView
        android:id="@+id/memberRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_teacher_add_section_button"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/group_member_remove_confirm"
        android:textColor="@color/teacher_status_archived_text"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
