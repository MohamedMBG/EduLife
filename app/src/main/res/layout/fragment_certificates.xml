<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_background">

    <!-- ── HEADER ── -->
    <LinearLayout
        android:id="@+id/certsHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_padding_horizontal"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/header_padding_horizontal"
        android:paddingBottom="28dp">

        <!-- Back row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/certsBackButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/course_detail_back"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                app:tint="@color/brand_text_on_primary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </LinearLayout>

        <!-- Title block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/certs_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/brand_text_on_primary_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/certs_title"
            android:textColor="@color/brand_text_on_primary"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/certs_subtitle"
            android:textColor="@color/brand_text_on_primary_muted"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

    <!-- ── LOADING ── -->
    <ProgressBar
        android:id="@+id/certsProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="gone" />

    <!-- ── ERROR ── -->
    <TextView
        android:id="@+id/certsError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:gravity="center"
        android:textColor="@color/brand_error"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ── EMPTY STATE ── -->
    <LinearLayout
        android:id="@+id/certsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="60dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_cert_icon">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_certificate_ribbon"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/certs_empty_title"
            android:textColor="@color/brand_text_primary"
            android:textSize="17sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/certs_empty_subtitle"
            android:textColor="@color/brand_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5" />

    </LinearLayout>

    <!-- ── LIST ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/certsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:visibility="gone" />

</LinearLayout>
