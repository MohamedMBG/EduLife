<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <!-- Score circle -->
    <FrameLayout
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_profile_avatar">

        <TextView
            android:id="@+id/resultScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_primary"
            android:textSize="36sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Pass / fail label -->
    <TextView
        android:id="@+id/resultStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Pass threshold -->
    <TextView
        android:id="@+id/resultThresholdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/brand_text_secondary"
        android:textSize="14sp" />

    <!-- Certificate card — visible only on pass -->
    <LinearLayout
        android:id="@+id/resultCertCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_course_card"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exam_result_cert_label"
            android:textAllCaps="true"
            android:textColor="@color/brand_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultCertNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Actions -->
    <Button
        android:id="@+id/resultBackButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_enroll_cta_button"
        android:text="@string/exam_result_back"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/resultRetryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_lesson_nav_button_outline"
        android:text="@string/exam_result_retry"
        android:textAllCaps="false"
        android:textColor="@color/brand_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
