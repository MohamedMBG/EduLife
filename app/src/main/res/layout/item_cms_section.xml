<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_teacher_course_card"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:gravity="center_vertical">

    <!-- Order circle -->
    <TextView
        android:id="@+id/cmsSectionOrder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_teacher_status_published"
        android:gravity="center"
        android:textColor="@color/teacher_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cmsSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/teacher_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Getting Started with Android" />

    </LinearLayout>

    <!-- Delete icon -->
    <TextView
        android:id="@+id/cmsSectionDeleteIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="✕"
        android:textColor="@color/brand_error"
        android:textSize="16sp"
        android:padding="8dp"
        android:contentDescription="Delete section" />

</LinearLayout>
