<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for devices below API 31.

  Excludes the encrypted session prefs so a cloud-restored install never reuses an
  identity that belonged to a previous device. The Firebase ID token is not stored
  here, but the persisted userId + role are still sensitive identifiers tied to a
  verified Firebase account.

  The legacy "edulife_session" name is excluded too in case an upgraded install
  still has the old plaintext file mid-migration when a backup is taken.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="edulife_session_secure.xml"/>
    <exclude domain="sharedpref" path="edulife_session.xml"/>
</full-backup-content>
