<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 Auto Backup is disabled in the manifest via android:allowBackup="false",
  so this rule file should not actually run. It is kept (and explicitly excludes the
  whole app) only so a future flip back to allowBackup="true" cannot accidentally
  ship learner identity, planner data, certificates, or analytics caches to the
  cloud without an intentional review of every domain listed here.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database"  path="."/>
    <exclude domain="file"      path="."/>
    <exclude domain="external"  path="."/>
    <exclude domain="root"      path="."/>
</full-backup-content>
