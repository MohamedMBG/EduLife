<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+ Auto Backup and Device-to-Device transfer.

  Cloud backup and device transfer both exclude the encrypted session prefs and
  the legacy plaintext file so the EduLife identity is never restored onto a
  device the original learner does not control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="edulife_session_secure.xml"/>
        <exclude domain="sharedpref" path="edulife_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="edulife_session_secure.xml"/>
        <exclude domain="sharedpref" path="edulife_session.xml"/>
    </device-transfer>
</data-extraction-rules>
