<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for EduLife.

  Rules:
    - Production traffic must be HTTPS only. The default base-config blocks cleartext.
    - Local development against the emulator (10.0.2.2 → host machine) and a host's
      loopback interface is allowed in cleartext so debug builds can still reach the
      Spring Boot dev server without a TLS cert.
    - SSL pinning is intentionally not configured here yet; pin digests will be added
      once the production backend certificate chain is finalised.

  When the production domain is registered, add a <domain-config> block pinning the
  leaf or intermediate SubjectPublicKeyInfo via <pin-set>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Android emulator forwards 10.0.2.2 to the host machine, so debug builds reach
         the local Spring Boot instance running on the developer's laptop. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
