<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for EduLife.

  Rules:
    - Production traffic must be HTTPS only. The default base-config blocks cleartext.
    - Local cleartext development hosts live only in src/debug/debug_network_security_config.xml.
    - SSL pinning is intentionally not configured here yet; pin digests will be added
      once the production backend certificate chain is finalised.

  When the production domain is registered, add a <domain-config> block pinning the
  leaf or intermediate SubjectPublicKeyInfo via <pin-set>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      TLS certificate pinning template (audit 2026-06-19 P3-3). INTENTIONALLY INACTIVE.

      DO NOT uncomment with placeholder pins — a wrong/expired SubjectPublicKeyInfo pin will
      hard-fail every API call and brick the app in the field. Activate only after:
        1. Replacing <domain> with the real production API host.
        2. Filling BOTH <pin> digests with the base64 SHA-256 SPKI of (a) the current cert's
           CA/intermediate and (b) a backup (next CA or self-managed key). Two pins are required
           so a single rotation does not lock users out.
        3. Confirming the rotation strategy: the backend currently terminates TLS behind Render's
           Let's Encrypt certs, which rotate ~every 90 days. Pin the Let's Encrypt INTERMEDIATE
           (e.g. R10/R11/E1) SPKI — NOT the rotating leaf — or move to a pinned custom domain.
        4. Setting an <expiration> so an unmaintained pin fails open instead of bricking installs.

      Compute a pin:
        openssl s_client -connect <host>:443 -servername <host> </dev/null 2>/dev/null \
          | openssl x509 -pubkey -noout \
          | openssl pkey -pubin -outform der \
          | openssl dgst -sha256 -binary | openssl enc -base64
    -->
    <!--
    <domain-config>
        <domain includeSubdomains="true">REPLACE_WITH_PROD_API_HOST</domain>
        <pin-set expiration="2026-12-31">
            <pin digest="SHA-256">REPLACE_WITH_INTERMEDIATE_SPKI_PIN=</pin>
            <pin digest="SHA-256">REPLACE_WITH_BACKUP_SPKI_PIN=</pin>
        </pin-set>
    </domain-config>
    -->

</network-security-config>
