<?xml version="1.0" encoding="utf-8"?>
<!-- Highlighted progress card with a tinted background to make it stand out as the primary data card -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_primary_surface" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_primary_border" />
</shape>
