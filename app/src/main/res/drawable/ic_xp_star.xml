<?xml version="1.0" encoding="utf-8"?>
<!-- Premium XP star icon with modern dual-tone gold gradient, drop shadow, and glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Soft outer glow (scaled 1.15x around center) -->
    <path
        android:fillColor="#25FFD54F"
        android:pathData="M12,0.5 L15.55,7.7 L23.5,8.86 L17.75,14.46 L19.11,22.37 L12,18.64 L4.89,22.37 L6.25,14.46 L0.5,8.86 L8.45,7.7 Z" />

    <!-- Subtle drop shadow to give depth to the star -->
    <path
        android:fillColor="#25000000"
        android:pathData="M12,3.3l3.09,6.26L22,10.57l-5,4.87 1.18,6.88L12,19.07l-6.18,3.25L7,15.44 2,10.57l6.91,-1.01z" />

    <!-- Main premium gold gradient star -->
    <path android:pathData="M12,2l3.09,6.26L22,9.27l-5,4.87 1.18,6.88L12,17.77l-6.18,3.25L7,14.14 2,9.27l6.91,-1.01z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="12"
                android:startY="2"
                android:endX="12"
                android:endY="22"
                android:type="linear">
                <!-- Rich gold/yellow gradient -->
                <item
                    android:color="#FFE57F"
                    android:offset="0.0" />
                <item
                    android:color="#FFD54F"
                    android:offset="0.3" />
                <item
                    android:color="#FFB300"
                    android:offset="0.75" />
                <item
                    android:color="#FF8F00"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer glowing stroke to make the star pop on all background shades -->
    <path
        android:strokeColor="#FFE082"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:pathData="M12,2l3.09,6.26L22,9.27l-5,4.87 1.18,6.88L12,17.77l-6.18,3.25L7,14.14 2,9.27l6.91,-1.01z" />
</vector>
