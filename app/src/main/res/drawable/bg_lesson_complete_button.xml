<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled / Completed state: light mint surface with a solid green border -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Pressed state: deep dark green -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Default state: standard forest green button -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
