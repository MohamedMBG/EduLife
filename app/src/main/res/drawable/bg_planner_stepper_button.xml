<?xml version="1.0" encoding="utf-8"?>
<!-- Circular stepper button (+/-) for the planner target hours control -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/brand_primary_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/brand_surface_muted" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_border" />
        </shape>
    </item>
</selector>
