<?xml version="1.0" encoding="utf-8"?>
<!-- Standard rounded surface card for the Study Analytics screen. Soft border, no harsh shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_surface" />
    <corners android:radius="@dimen/study_card_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_border" />
</shape>
