<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inputs use a real border instead of only elevation so fields remain readable in low contrast modes. -->
    <solid android:color="@color/login_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/login_border_strong" />
    <corners android:radius="16dp" />
    <padding
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp" />
</shape>
