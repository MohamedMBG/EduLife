<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds can target emulator localhost or the developer machine LAN IP before HTTPS is available. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
