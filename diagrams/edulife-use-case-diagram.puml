@startuml EduLifeUseCaseFr

left to right direction
scale max 2480x3508

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Serif"
skinparam defaultFontSize 12
skinparam dpi 200
skinparam nodesep 22
skinparam ranksep 30
skinparam linetype ortho

skinparam rectangle {
    BackgroundColor White
    BorderColor Black
    FontSize 18
    FontStyle bold
}

skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #999999
    FontSize 14
    FontStyle italic
    BorderStyle dashed
}

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 11
}

skinparam actor {
    BorderColor Black
    FontSize 11
}

skinparam ArrowColor Black
skinparam ArrowFontSize 9

actor "Apprenant" as Learner
actor "Enseignant" as Teacher
actor "Admin\nGroupe" as GroupAdmin
actor "Admin\nPlateforme" as PlatformAdmin

rectangle "Firebase\nAuthentication" as Firebase
actor "Stockage\nCloudinary" as Cloudinary
actor "Service IA\nGroq" as Groq

rectangle "                            Systeme EduLife                            " {

    package "Service d'apprentissage et de certification" {
        (S'inscrire\net verifier l'e-mail) as L1
        (Se connecter\net synchroniser l'identite) as L2
        (Gerer le profil\net l'avatar) as L3
        (Parcourir les cours\net voir le detail) as L4
        (S'inscrire\na un cours) as L5
        (Acceder aux lecons\net suivre la progression) as L6
        (Passer et soumettre\nl'examen QCM) as L7
        (Consulter le resultat\net generer le certificat) as L8
        (Telecharger ou verifier\nun certificat) as L9
        (Consulter la gamification\net le classement) as L10
        (Consulter les analytics\napprenant) as L11
        (Utiliser le planner\nd'etude) as L12
        (Utiliser l'advisor\ncarriere) as L13

        L1 -[hidden]right- L8
        L2 -[hidden]right- L9
        L3 -[hidden]right- L10
        L4 -[hidden]right- L11
        L5 -[hidden]right- L12
        L6 -[hidden]right- L13

        L1 -[hidden]down- L2
        L2 -[hidden]down- L3
        L3 -[hidden]down- L4
        L4 -[hidden]down- L5
        L5 -[hidden]down- L6
        L6 -[hidden]down- L7

        L8 -[hidden]down- L9
        L9 -[hidden]down- L10
        L10 -[hidden]down- L11
        L11 -[hidden]down- L12
        L12 -[hidden]down- L13
    }

    package "Service contenu, groupe et administration" {
        (Demander le role\nd'enseignant) as C1
        (Creer un cours) as C2
        (Gerer sections, lecons\net image de couverture) as C3
        (Creer l'examen final) as C4
        (Consulter les analytics\nenseignant) as C5
        (Creer un groupe) as C6
        (Gerer les membres\net les adhesions) as C7
        (Attacher et approuver\nles cours du groupe) as C8
        (Consulter les analytics\ndu groupe) as C9
        (Examiner les demandes\nd'enseignant) as C10
        (Publier ou archiver\nun cours) as C11
        (Gerer les utilisateurs\net les roles) as C12
        (Consulter les metriques\net analytics plateforme) as C13
        (Supprimer le compte) as C14

        C1 -[hidden]right- C8
        C2 -[hidden]right- C9
        C3 -[hidden]right- C10
        C4 -[hidden]right- C11
        C5 -[hidden]right- C12
        C6 -[hidden]right- C13
        C7 -[hidden]right- C14

        C1 -[hidden]down- C2
        C2 -[hidden]down- C3
        C3 -[hidden]down- C4
        C4 -[hidden]down- C5
        C5 -[hidden]down- C6
        C6 -[hidden]down- C7

        C8 -[hidden]down- C9
        C9 -[hidden]down- C10
        C10 -[hidden]down- C11
        C11 -[hidden]down- C12
        C12 -[hidden]down- C13
        C13 -[hidden]down- C14
    }
}

Learner -- L1
Learner -- L2
Learner -- L3
Learner -- L4
Learner -- L5
Learner -- L6
Learner -- L7
Learner -- L8
Learner -- L9
Learner -- L10
Learner -- L11
Learner -- L12
Learner -- L13
Learner -- C1
Learner -- C14

Teacher -- L2
Teacher -- C2
Teacher -- C3
Teacher -- C4
Teacher -- C5

GroupAdmin -- L2
GroupAdmin -- C6
GroupAdmin -- C7
GroupAdmin -- C8
GroupAdmin -- C9

PlatformAdmin -- L2
PlatformAdmin -- C10
PlatformAdmin -- C11
PlatformAdmin -- C12
PlatformAdmin -- C13

L1 -- Firebase
L2 -- Firebase

L3 -- Cloudinary
C3 -- Cloudinary

L13 -- Groq

L5 .> L4 : <<extend>>
L6 .> L5 : <<extend>>
L7 .> L6 : <<extend>>
L8 .> L7 : <<include>>
L9 .> L8 : <<extend>>
C3 .> C2 : <<include>>
C8 .> C6 : <<extend>>
C11 .> C2 : <<extend>>

@enduml
