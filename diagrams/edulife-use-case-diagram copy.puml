@startuml EduLifeUseCaseFrHorizontal

' Force a landscape reading direction because this diagram is consumed in reports and presentations.
left to right direction
' Use landscape bounds so PlantUML can expand the flow horizontally instead of compressing it into portrait columns.
scale max 3508x2480

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Serif"
skinparam defaultFontSize 12
skinparam dpi 200
skinparam nodesep 28
skinparam ranksep 42
skinparam linetype ortho

skinparam rectangle {
    BackgroundColor White
    BorderColor Black
    FontSize 18
    FontStyle bold
    RoundCorner 14
}

skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #999999
    FontSize 14
    FontStyle italic
    BorderStyle dashed
}

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 11
}

skinparam actor {
    BorderColor Black
    FontSize 11
}

skinparam ArrowColor Black
skinparam ArrowFontSize 9

actor "Apprenant" as Learner
actor "Enseignant" as Teacher
actor "Admin\nGroupe" as GroupAdmin
actor "Admin\nPlateforme" as PlatformAdmin

rectangle "Firebase\nAuthentication" as Firebase
actor "Stockage\nCloudinary" as Cloudinary
actor "Service IA\nGroq" as Groq

rectangle "Systeme EduLife" {

    ' Rows are modeled directly inside the system boundary because nested clusters were collapsing the layout vertically.
    together {
        (S'inscrire) as UC1
        (Verifier l'e-mail) as UC3
        (Se connecter) as UC2
        (Synchroniser\nl'identite) as UC4
        (Gerer le profil) as UC5
        (Importer un\navatar) as UC6
        (Supprimer le\ncompte) as UC42
    }

    together {
        (Parcourir les\ncours) as UC7
        (Voir le detail\nd'un cours) as UC8
        (S'inscrire a\nun cours) as UC9
        (Acceder aux\nlecons) as UC10
        (Marquer une lecon\nterminee) as UC11
        (Suivre la\nprogression) as UC12
        (Consulter la\ngamification) as UC19
        (Consulter le\nclassement) as UC20
        (Consulter les analytics\napprenant) as UC21
        (Utiliser le planner\nd'etude) as UC22
        (Utiliser l'advisor\ncarriere) as UC23
    }

    together {
        (Passer l'examen\nQCM) as UC13
        (Soumettre\nl'examen) as UC14
        (Consulter le\nresultat) as UC15
        (Generer le\ncertificat) as UC16
        (Telecharger le\ncertificat) as UC17
        (Verifier un\ncertificat) as UC18
    }

    together {
        (Demander le role\nenseignant) as UC24
        (Examiner les demandes\nenseignant) as UC25
        (Creer un\ncours) as UC26
        (Gerer sections\net lecons) as UC27
        (Importer l'image\nde couverture) as UC28
        (Creer l'examen\nfinal) as UC29
        (Publier le\ncours) as UC30
        (Archiver le\ncours) as UC31
        (Consulter les analytics\nenseignant) as UC32
        (Creer un\ngroupe) as UC33
        (Gerer les membres\ndu groupe) as UC34
        (Approuver les demandes\nd'adhesion) as UC35
        (Attacher des cours\nau groupe) as UC36
        (Approuver les cours\ndu groupe) as UC37
        (Consulter les analytics\ndu groupe) as UC38
        (Gerer les utilisateurs\net les roles) as UC39
        (Consulter les metriques\nplateforme) as UC40
        (Consulter les analytics\nplateforme) as UC41
    }
}

