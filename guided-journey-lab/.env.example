# Demo mode runs the site fully locally with mock data and a fake sign-in (NO backend, NO real
# auth). It must stay false for any real/production deployment. Set true only for a standalone UI demo.
VITE_DEMO_MODE=false
# Production must be an HTTPS origin (the Firebase token is sent on every request). HTTP is only
# allowed for localhost / 127.0.0.1 during local development.
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
