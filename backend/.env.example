# EduLife backend environment variables
# Copy to backend/.env, fill all required values, then run backend/run-local.ps1.
# Required = must be set in production. Optional = has a safe default for local dev.

# ── Database ──────────────────────────────────────────────────────────────────
# Required in production. The user must own the schema so Flyway can run migrations.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edulife
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Required. Provide exactly one of the two options below; do NOT commit real credentials.
# Option A — path to a service account JSON file on the host filesystem:
FIREBASE_ADMIN_CREDENTIALS_PATH=C:\secure\edulife-firebase-admin.json
# Option B — the service account JSON content as a single-line string (Cloud / CI friendly):
FIREBASE_ADMIN_CREDENTIALS_JSON=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Required in production. Comma-separated list of origins the web app will be served from.
# Example: https://guided-journey-lab.vercel.app,https://app.edulife.ma
# This must list the exact deployed browser origins that call the backend. If it omits the
# website origin, Firebase sign-in can succeed but /api/v1/auth/sync will still fail in-browser
# with a CORS TypeError that looks like a generic network outage.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://guided-journey-lab.vercel.app

# ── Avatar storage ────────────────────────────────────────────────────────────
# Required in production. Directory must exist and be writable by the process user.
# The backend validates writability at startup and will refuse to start if the dir is missing.
# The public base URL must be reachable by Android and web clients (img tags + download links).
EDULIFE_AVATAR_STORAGE_DIR=/var/edulife/uploads/avatars
EDULIFE_AVATAR_PUBLIC_BASE_URL=https://api.edulife.ma/uploads/avatars
# Optional — override the 5 MB upload limit (bytes).
EDULIFE_AVATAR_MAX_FILE_BYTES=5242880

# ── Certificate storage ───────────────────────────────────────────────────────
# Required in production. Directory must exist and be writable by the process user.
# The backend validates writability at startup and will refuse to start if the dir is missing.
# PDFs are generated here on exam pass; the public base URL is used to build download links.
EDULIFE_CERTIFICATES_STORAGE_DIR=/var/edulife/storage/certificates
EDULIFE_CERTIFICATES_PUBLIC_BASE_URL=https://api.edulife.ma/api/v1/certificates
