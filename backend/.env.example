# Local backend environment for website authentication.
# Copy to backend/.env, fill Firebase credentials, then run backend/run-local.ps1.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edulife
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Use one Firebase Admin credential source. Do not commit real credentials.
FIREBASE_ADMIN_CREDENTIALS_PATH=C:\secure\edulife-firebase-admin.json
FIREBASE_ADMIN_CREDENTIALS_JSON=

# The website must be explicitly allowed by CORS before the browser can call /api/v1/auth/sync.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
